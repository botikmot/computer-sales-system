generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PURCHASING
  INVENTORY
  TECHNICIAN
  CASHIER
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE_OUT
  REPAIR_ISSUE
  ASSEMBLY_CONSUMPTION
  ASSEMBLY_OUTPUT
  ADJUSTMENT
}

enum AssemblyStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SupplierQuotationStatus {
  DRAFT
  RECEIVED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ReceivingStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ReceivingCheckStatus {
  PENDING
  VERIFIED
  FAILED
}

enum PaymentMode {
  COD
  TERMS
  CASH
}

enum AccountsPayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SupplierPaymentStatus {
  POSTED
  CANCELLED
}

enum CashBankAccountType {
  CASH
  BANK
}

enum CashBankTransactionType {
  SUPPLIER_PAYMENT
  CUSTOMER_PAYMENT
}

enum CashBankTransactionDirection {
  IN
  OUT
}

enum SalesInquiryStatus {
  OPEN
  QUOTED
  CONVERTED
  CANCELLED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  CONFIRMED
  RESERVED
  READY
  DELIVERED
  CANCELLED
}

enum SalesOrderDeliveryMode {
  DELIVERY
  CUSTOMER_PICKUP
}

enum InventoryReservationStatus {
  RESERVED
  RELEASED
  CONSUMED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesPaymentMode {
  CASH
  CREDIT
}

enum CustomerPaymentStatus {
  POSTED
  CANCELLED
}

enum AccountsReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Branch {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  address               String?
  phone                 String?
  email                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  purchaseRequests      PurchaseRequest[]
  supplierQuotations    SupplierQuotation[]
  purchaseOrders        PurchaseOrder[]
  receivings            Receiving[]
  purchaseInvoices      PurchaseInvoice[]
  accountsPayables      AccountsPayable[]
  supplierPayments      SupplierPayment[]
  cashBankTransactions  CashBankTransaction[]
  cashBankAccounts      CashBankAccount[]
  paymentVouchers       PaymentVoucher[]
  salesInquiries        SalesInquiry[]
  salesQuotations       SalesQuotation[]
  salesOrders           SalesOrder[]
  inventoryReservations InventoryReservation[]
  salesInvoices         SalesInvoice[]
  customerPayments      CustomerPayment[]
  accountsReceivables   AccountsReceivable[]

  users              User[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  assemblies         Assembly[]

  @@index([isActive])
}

model User {
  id                          String                @id @default(uuid())
  username                    String                @unique
  email                       String?               @unique
  fullName                    String
  passwordHash                String
  role                        UserRole              @default(SALES)
  status                      UserStatus            @default(ACTIVE)
  purchaseRequestsCreated     PurchaseRequest[]     @relation("PurchaseRequestCreatedBy")
  supplierQuotationsCreated   SupplierQuotation[]   @relation("SupplierQuotationCreatedBy")
  purchaseOrdersCreated       PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  receivingsCreated           Receiving[]           @relation("ReceivingCreatedBy")
  receivingsChecked           Receiving[]           @relation("ReceivingCheckedBy")
  purchaseInvoicesCreated     PurchaseInvoice[]     @relation("PurchaseInvoiceCreatedBy")
  accountsPayablesCreated     AccountsPayable[]     @relation("AccountsPayableCreatedBy")
  supplierPaymentsCreated     SupplierPayment[]     @relation("SupplierPaymentsCreated")
  cashBankTransactionsCreated CashBankTransaction[] @relation("CashBankTransactionsCreated")
  paymentVouchersCreated      PaymentVoucher[]      @relation("PaymentVouchersCreated")
  salesInquiriesCreated       SalesInquiry[]        @relation("SalesInquiriesCreated")
  salesQuotationsCreated      SalesQuotation[]      @relation("SalesQuotationsCreated")
  salesOrdersCreated          SalesOrder[]          @relation("SalesOrdersCreated")
  salesInvoicesCreated        SalesInvoice[]        @relation("SalesInvoicesCreated")
  customerPaymentsCreated     CustomerPayment[]     @relation("CustomerPaymentsCreated")
  accountsReceivablesCreated  AccountsReceivable[]  @relation("AccountsReceivablesCreated")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
}

model Customer {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  contactNumber       String?
  email               String?
  address             String?
  taxId               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  salesInquiries      SalesInquiry[]
  salesQuotations     SalesQuotation[]
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  customerPayments    CustomerPayment[]
  accountsReceivables AccountsReceivable[]

  @@index([name])
  @@index([isActive])
}

model Supplier {
  id                 String              @id @default(uuid())
  code               String              @unique
  name               String
  contactPerson      String?
  contactNumber      String?
  email              String?
  address            String?
  taxId              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  accountsPayables   AccountsPayable[]
  supplierPayments   SupplierPayment[]

  @@index([name])
  @@index([isActive])
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String?
  brand       String?
  model       String?
  unit        String  @default("pcs")

  defaultSellingPrice Decimal? @db.Decimal(12, 2)
  defaultCostPrice    Decimal? @db.Decimal(12, 2)

  isActive               Boolean                 @default(true)
  trackInventory         Boolean                 @default(true)
  purchaseRequestItems   PurchaseRequestItem[]
  supplierQuotationItems SupplierQuotationItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  receivingItems         ReceivingItem[]
  purchaseInvoiceItems   PurchaseInvoiceItem[]
  salesInquiryItems      SalesInquiryItem[]
  salesQuotationItems    SalesQuotationItem[]
  salesOrderItems        SalesOrderItem[]
  inventoryReservations  InventoryReservation[]
  salesInvoiceItems      SalesInvoiceItem[]

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  finishedBom   BillOfMaterial?      @relation("BOMFinishedProduct")
  bomComponents BillOfMaterialItem[] @relation("BOMComponent")

  assemblyOutputs    Assembly[]          @relation("AssemblyFinishedProduct")
  assemblyComponents AssemblyComponent[] @relation("AssemblyComponentProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([brand])
  @@index([categoryId])
  @@index([isActive])
}

model InventoryBalance {
  id          String  @id @default(uuid())
  branchId    String
  productId   String
  quantity    Int     @default(0)
  averageCost Decimal @default(0) @db.Decimal(12, 2)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

model InventoryMovement {
  id        String                @id @default(uuid())
  branchId  String
  productId String
  type      InventoryMovementType

  unitCost         Decimal? @db.Decimal(12, 2)
  totalCost        Decimal? @db.Decimal(12, 2)
  averageCostAfter Decimal? @db.Decimal(12, 2)

  quantityChange Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  notes          String?

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  assemblyId String?
  assembly   Assembly? @relation("AssemblyInventoryMovement", fields: [assemblyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([branchId, productId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([assemblyId])
  @@index([createdAt])
}

model BillOfMaterial {
  id        String  @id @default(uuid())
  productId String  @unique
  name      String?
  isActive  Boolean @default(true)

  product Product @relation("BOMFinishedProduct", fields: [productId], references: [id], onDelete: Cascade)

  items      BillOfMaterialItem[]
  assemblies Assembly[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillOfMaterialItem {
  id                 String @id @default(uuid())
  billOfMaterialId   String
  componentProductId String
  quantity           Int

  billOfMaterial BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Cascade)

  componentProduct Product @relation("BOMComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([billOfMaterialId, componentProductId])
  @@index([componentProductId])
}

model Assembly {
  id                String @id @default(uuid())
  branchId          String
  billOfMaterialId  String
  finishedProductId String

  quantityProduced Int
  status           AssemblyStatus @default(COMPLETED)

  notes String?

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  billOfMaterial BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Restrict)

  finishedProduct Product @relation("AssemblyFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)

  components AssemblyComponent[]

  inventoryMovements InventoryMovement[] @relation("AssemblyInventoryMovement")

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([finishedProductId])
  @@index([billOfMaterialId])
  @@index([createdAt])
}

model AssemblyComponent {
  id                 String @id @default(uuid())
  assemblyId         String
  componentProductId String
  quantityConsumed   Int

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  componentProduct Product @relation("AssemblyComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([assemblyId, componentProductId])
  @@index([componentProductId])
}

model PurchaseRequest {
  id        String                @id @default(uuid())
  requestNo String                @unique
  branchId  String
  status    PurchaseRequestStatus @default(DRAFT)

  purpose String?
  notes   String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseRequestItem[]

  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                String  @id @default(uuid())
  purchaseRequestId String
  productId         String
  quantity          Int
  notes             String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestId])
  @@index([productId])
}

model SupplierQuotation {
  id                String  @id @default(uuid())
  quotationNo       String  @unique
  branchId          String
  supplierId        String
  purchaseRequestId String?

  status SupplierQuotationStatus @default(DRAFT)

  quotationDate DateTime  @default(now())
  validUntil    DateTime?
  notes         String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("SupplierQuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items SupplierQuotationItem[]

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseRequestId])
  @@index([status])
}

model SupplierQuotationItem {
  id                  String @id @default(uuid())
  supplierQuotationId String
  productId           String

  quantity Int
  unitCost Decimal @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)

  supplierQuotation SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([supplierQuotationId])
  @@index([productId])
}

model PurchaseOrder {
  id                  String  @id @default(uuid())
  poNumber            String  @unique
  branchId            String
  supplierId          String
  purchaseRequestId   String?
  supplierQuotationId String?

  status PurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  supplierQuotation SupplierQuotation? @relation(fields: [supplierQuotationId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseOrderItem[]

  receivings       Receiving[]
  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseRequestId])
  @@index([supplierQuotationId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String

  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

  receivedQuantity Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  receivingItems ReceivingItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model Receiving {
  id              String @id @default(uuid())
  receivingNo     String @unique
  branchId        String
  purchaseOrderId String

  status ReceivingStatus @default(DRAFT)

  receivedDate DateTime             @default(now())
  referenceNo  String?
  notes        String?
  checkStatus  ReceivingCheckStatus @default(PENDING)

  checkedAt   DateTime?
  checkedById String?
  checkNotes  String?

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("ReceivingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkedBy   User?   @relation("ReceivingCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  items ReceivingItem[]

  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
}

model ReceivingItem {
  id                  String @id @default(uuid())
  receivingId         String
  purchaseOrderItemId String
  productId           String

  quantityReceived Int
  quantityAccepted Int @default(0)
  quantityRejected Int @default(0)

  qualityStatus String?
  qualityNotes  String?

  notes String?

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([receivingId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model PurchaseInvoice {
  id                String  @id @default(uuid())
  invoiceNo         String  @unique
  supplierInvoiceNo String?

  branchId        String
  supplierId      String
  purchaseOrderId String?
  receivingId     String?

  status      PurchaseInvoiceStatus @default(DRAFT)
  paymentMode PaymentMode           @default(TERMS)

  invoiceDate     DateTime         @default(now())
  dueDate         DateTime?
  accountsPayable AccountsPayable?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  balanceDue Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receiving     Receiving?     @relation(fields: [receivingId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([receivingId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
}

model PurchaseInvoiceItem {
  id                String @id @default(uuid())
  purchaseInvoiceId String
  productId         String

  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model AccountsPayable {
  id                String @id @default(uuid())
  branchId          String
  supplierId        String
  purchaseInvoiceId String @unique

  paymentMode PaymentMode
  status      AccountsPayableStatus @default(OPEN)

  originalAmount Decimal           @db.Decimal(12, 2)
  amountPaid     Decimal           @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal           @db.Decimal(12, 2)
  payments       SupplierPayment[]

  dueDate DateTime?
  notes   String?

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("AccountsPayableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentMode])
  @@index([dueDate])
  @@index([createdAt])
}

model SupplierPayment {
  id        String @id @default(uuid())
  paymentNo String @unique

  branchId          String
  supplierId        String
  accountsPayableId String

  accountId String

  accountType CashBankAccountType

  amount         Decimal         @db.Decimal(12, 2)
  paymentDate    DateTime        @default(now())
  referenceNo    String?
  notes          String?
  paymentVoucher PaymentVoucher?

  status SupplierPaymentStatus @default(POSTED)

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  accountsPayable AccountsPayable @relation(fields: [accountsPayableId], references: [id], onDelete: Restrict)

  account CashBankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("SupplierPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  cashBankTransaction CashBankTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([accountsPayableId])
  @@index([paymentDate])
  @@index([status])
}

model CashBankTransaction {
  id String @id @default(uuid())

  branchId          String
  supplierPaymentId String? @unique
  customerPaymentId String? @unique

  accountId String

  accountType CashBankAccountType
  accountName String

  transactionType CashBankTransactionType
  direction       CashBankTransactionDirection

  amount Decimal @db.Decimal(12, 2)

  transactionDate DateTime @default(now())
  referenceNo     String?
  notes           String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  account CashBankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CashBankTransactionsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([accountId])
  @@index([accountType])
  @@index([transactionType])
  @@index([direction])
  @@index([transactionDate])
}

model CashBankAccount {
  id       String @id @default(uuid())
  branchId String

  accountType   CashBankAccountType
  name          String
  accountNumber String?

  openingBalance Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  supplierPayments SupplierPayment[]
  transactions     CashBankTransaction[]
  customerPayments CustomerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
  @@index([accountType])
  @@index([isActive])
}

model PaymentVoucher {
  id        String @id @default(uuid())
  voucherNo String @unique

  branchId          String
  supplierPaymentId String @unique

  voucherDate DateTime @default(now())
  payeeName   String
  amount      Decimal  @db.Decimal(12, 2)
  purpose     String?
  notes       String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("PaymentVouchersCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([voucherDate])
  @@index([payeeName])
}

model SalesInquiry {
  id String @id @default(uuid())

  inquiryNo String @unique

  branchId   String
  customerId String

  status SalesInquiryStatus @default(OPEN)

  inquiryDate DateTime @default(now())

  notes String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items SalesInquiryItem[]

  createdById String?
  createdBy   User?   @relation("SalesInquiriesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  quotations SalesQuotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([inquiryDate])
}

model SalesInquiryItem {
  id String @id @default(uuid())

  salesInquiryId String
  productId      String

  quantity Int

  notes String?

  salesInquiry SalesInquiry @relation(fields: [salesInquiryId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesInquiryId])
  @@index([productId])
}

model SalesQuotation {
  id String @id @default(uuid())

  quotationNo String @unique

  branchId   String
  customerId String
  inquiryId  String

  status SalesQuotationStatus @default(DRAFT)

  quotationDate DateTime  @default(now())
  validUntil    DateTime?

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  inquiry SalesInquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)

  items      SalesQuotationItem[]
  salesOrder SalesOrder?

  createdById String?
  createdBy   User?   @relation("SalesQuotationsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([inquiryId])
  @@index([status])
  @@index([quotationDate])
}

model SalesQuotationItem {
  id String @id @default(uuid())

  salesQuotationId String
  productId        String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  salesQuotation SalesQuotation @relation(fields: [salesQuotationId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesQuotationId])
  @@index([productId])
}

model SalesOrder {
  id String @id @default(uuid())

  orderNo String @unique

  branchId    String
  customerId  String
  quotationId String @unique

  status SalesOrderStatus @default(CONFIRMED)

  orderDate DateTime @default(now())

  deliveryMode SalesOrderDeliveryMode?
  deliveryDate DateTime?

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  items                 SalesOrderItem[]
  inventoryReservations InventoryReservation[]
  salesInvoice          SalesInvoice?

  createdById String?
  createdBy   User?   @relation("SalesOrdersCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SalesOrderItem {
  id String @id @default(uuid())

  salesOrderId String
  productId    String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventoryReservation InventoryReservation?

  @@index([salesOrderId])
  @@index([productId])
}

model InventoryReservation {
  id String @id @default(uuid())

  branchId String

  salesOrderId     String
  salesOrderItemId String @unique
  productId        String

  quantity Int

  status InventoryReservationStatus @default(RESERVED)

  reservedAt DateTime  @default(now())
  releasedAt DateTime?
  consumedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([salesOrderId])
  @@index([productId])
  @@index([status])
}

model SalesInvoice {
  id String @id @default(uuid())

  invoiceNo String @unique

  branchId     String
  customerId   String
  salesOrderId String @unique

  status      SalesInvoiceStatus @default(DRAFT)
  paymentMode SalesPaymentMode

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  balanceDue Decimal @db.Decimal(12, 2)

  notes String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  items              SalesInvoiceItem[]
  customerPayments   CustomerPayment[]
  accountsReceivable AccountsReceivable?

  createdById String?
  createdBy   User?   @relation("SalesInvoicesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([paymentMode])
  @@index([invoiceDate])
  @@index([dueDate])
}

model SalesInvoiceItem {
  id String @id @default(uuid())

  salesInvoiceId String
  productId      String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId])
  @@index([productId])
}

model CustomerPayment {
  id String @id @default(uuid())

  paymentNo String @unique

  branchId       String
  customerId     String
  salesInvoiceId String
  accountId      String

  amount Decimal @db.Decimal(12, 2)

  paymentDate DateTime @default(now())
  referenceNo String?
  notes       String?

  status CustomerPaymentStatus @default(POSTED)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  account CashBankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  cashBankTransaction CashBankTransaction?

  createdById String?
  createdBy   User?   @relation("CustomerPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([salesInvoiceId])
  @@index([accountId])
  @@index([paymentDate])
  @@index([status])
}

model AccountsReceivable {
  id             String @id @default(uuid())
  branchId       String
  customerId     String
  salesInvoiceId String @unique

  originalAmount Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal @db.Decimal(12, 2)

  status AccountsReceivableStatus @default(OPEN)

  dueDate DateTime?
  notes   String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("AccountsReceivablesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}
