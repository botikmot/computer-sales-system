generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PURCHASING
  INVENTORY
  TECHNICIAN
  CASHIER
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE_OUT
  REPAIR_ISSUE
  ASSEMBLY_CONSUMPTION
  ASSEMBLY_OUTPUT
  ADJUSTMENT
}

enum AssemblyStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SupplierQuotationStatus {
  DRAFT
  RECEIVED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ReceivingStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseRequests   PurchaseRequest[]
  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]
  receivings         Receiving[]
  purchaseInvoices   PurchaseInvoice[]

  users              User[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  assemblies         Assembly[]

  @@index([isActive])
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String?    @unique
  fullName     String
  passwordHash String
  role         UserRole   @default(SALES)
  status       UserStatus @default(ACTIVE)
  purchaseRequestsCreated   PurchaseRequest[]   @relation("PurchaseRequestCreatedBy")
  supplierQuotationsCreated SupplierQuotation[] @relation("SupplierQuotationCreatedBy")
  purchaseOrdersCreated     PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  receivingsCreated          Receiving[]         @relation("ReceivingCreatedBy")
  purchaseInvoicesCreated   PurchaseInvoice[]   @relation("PurchaseInvoiceCreatedBy")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
}

model Customer {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactNumber String?
  email         String?
  address       String?
  taxId         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  contactNumber String?
  email         String?
  address       String?
  taxId         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]

  @@index([name])
  @@index([isActive])
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                  String   @id @default(uuid())
  sku                 String   @unique
  name                String
  description         String?
  brand               String?
  model               String?
  unit                String   @default("pcs")

  defaultSellingPrice Decimal? @db.Decimal(12, 2)
  defaultCostPrice    Decimal? @db.Decimal(12, 2)

  isActive       Boolean @default(true)
  trackInventory Boolean @default(true)
  purchaseRequestItems  PurchaseRequestItem[]
  supplierQuotationItems SupplierQuotationItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  receivingItems        ReceivingItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]

  finishedBom      BillOfMaterial? @relation("BOMFinishedProduct")
  bomComponents    BillOfMaterialItem[] @relation("BOMComponent")

  assemblyOutputs  Assembly[]          @relation("AssemblyFinishedProduct")
  assemblyComponents AssemblyComponent[] @relation("AssemblyComponentProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([brand])
  @@index([categoryId])
  @@index([isActive])
}

model InventoryBalance {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  quantity  Int      @default(0)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

model InventoryMovement {
  id              String                  @id @default(uuid())
  branchId        String
  productId       String
  type            InventoryMovementType
  quantityChange  Int
  balanceAfter    Int
  referenceType   String?
  referenceId     String?
  notes           String?

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  assemblyId String?
  assembly   Assembly? @relation("AssemblyInventoryMovement", fields: [assemblyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([branchId, productId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([assemblyId])
  @@index([createdAt])
}

model BillOfMaterial {
  id        String   @id @default(uuid())
  productId String   @unique
  name      String?
  isActive  Boolean  @default(true)

  product Product @relation("BOMFinishedProduct", fields: [productId], references: [id], onDelete: Cascade)

  items     BillOfMaterialItem[]
  assemblies Assembly[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillOfMaterialItem {
  id              String @id @default(uuid())
  billOfMaterialId String
  componentProductId String
  quantity         Int

  billOfMaterial BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Cascade)

  componentProduct Product @relation("BOMComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([billOfMaterialId, componentProductId])
  @@index([componentProductId])
}

model Assembly {
  id               String         @id @default(uuid())
  branchId         String
  billOfMaterialId String
  finishedProductId String

  quantityProduced Int
  status           AssemblyStatus @default(COMPLETED)

  notes String?

  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  billOfMaterial BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Restrict)

  finishedProduct Product @relation("AssemblyFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)

  components AssemblyComponent[]

  inventoryMovements InventoryMovement[] @relation("AssemblyInventoryMovement")

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([finishedProductId])
  @@index([billOfMaterialId])
  @@index([createdAt])
}

model AssemblyComponent {
  id                String @id @default(uuid())
  assemblyId        String
  componentProductId String
  quantityConsumed   Int

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  componentProduct Product @relation("AssemblyComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([assemblyId, componentProductId])
  @@index([componentProductId])
}

model PurchaseRequest {
  id       String               @id @default(uuid())
  requestNo String              @unique
  branchId String
  status   PurchaseRequestStatus @default(DRAFT)

  purpose String?
  notes   String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User? @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseRequestItem[]

  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id              String @id @default(uuid())
  purchaseRequestId String
  productId       String
  quantity        Int
  notes           String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestId])
  @@index([productId])
}

model SupplierQuotation {
  id            String                   @id @default(uuid())
  quotationNo   String                   @unique
  branchId      String
  supplierId    String
  purchaseRequestId String?

  status        SupplierQuotationStatus  @default(DRAFT)

  quotationDate DateTime @default(now())
  validUntil    DateTime?
  notes         String?

  subtotal      Decimal @db.Decimal(12, 2) @default(0)
  discount      Decimal @db.Decimal(12, 2) @default(0)
  tax           Decimal @db.Decimal(12, 2) @default(0)
  total         Decimal @db.Decimal(12, 2) @default(0)

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("SupplierQuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items SupplierQuotationItem[]

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseRequestId])
  @@index([status])
}

model SupplierQuotationItem {
  id                  String @id @default(uuid())
  supplierQuotationId String
  productId           String

  quantity Int
  unitCost Decimal @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)

  supplierQuotation SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([supplierQuotationId])
  @@index([productId])
}

model PurchaseOrder {
  id                  String               @id @default(uuid())
  poNumber            String               @unique
  branchId            String
  supplierId          String
  purchaseRequestId   String?
  supplierQuotationId String?

  status PurchaseOrderStatus @default(DRAFT)

  orderDate DateTime @default(now())
  expectedDate DateTime?
  notes String?

  subtotal Decimal @db.Decimal(12, 2) @default(0)
  discount Decimal @db.Decimal(12, 2) @default(0)
  tax      Decimal @db.Decimal(12, 2) @default(0)
  total    Decimal @db.Decimal(12, 2) @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)

  supplierQuotation SupplierQuotation? @relation(fields: [supplierQuotationId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseOrderItem[]

  receivings Receiving[]
  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseRequestId])
  @@index([supplierQuotationId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id             String @id @default(uuid())
  purchaseOrderId String
  productId      String

  quantity  Int
  unitCost  Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  receivedQuantity Int @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  receivingItems ReceivingItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model Receiving {
  id            String          @id @default(uuid())
  receivingNo   String          @unique
  branchId      String
  purchaseOrderId String

  status ReceivingStatus @default(DRAFT)

  receivedDate DateTime @default(now())
  referenceNo String?
  notes String?

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User? @relation("ReceivingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items ReceivingItem[]

  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
}

model ReceivingItem {
  id                String @id @default(uuid())
  receivingId       String
  purchaseOrderItemId String
  productId         String

  quantityReceived Int

  notes String?

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([receivingId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  invoiceNo      String                @unique
  branchId       String
  supplierId     String
  purchaseOrderId String?
  receivingId    String?

  status PurchaseInvoiceStatus @default(DRAFT)

  invoiceDate DateTime @default(now())
  dueDate     DateTime?

  subtotal   Decimal @db.Decimal(12, 2) @default(0)
  discount   Decimal @db.Decimal(12, 2) @default(0)
  tax        Decimal @db.Decimal(12, 2) @default(0)
  total      Decimal @db.Decimal(12, 2) @default(0)

  amountPaid Decimal @db.Decimal(12, 2) @default(0)
  balanceDue Decimal @db.Decimal(12, 2) @default(0)

  notes String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receiving     Receiving?     @relation(fields: [receivingId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([receivingId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
}

model PurchaseInvoiceItem {
  id                String @id @default(uuid())
  purchaseInvoiceId String
  productId         String

  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseInvoiceId])
  @@index([productId])
}